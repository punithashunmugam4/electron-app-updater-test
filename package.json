    "clear-module": "4.1.2",
    "dialog": "0.3.1",
    "electron-context-menu": "^4.1.1",
    "electron-log": "5.4.3",
    "electron-reload": "latest",
    "electron-store": "11.0.2",
    "find-remove": "5.1.1",
    "http": "latest",
    "https": "latest",
    "https-proxy-agent": "7.0.6",
    "json5": "2.2.3",
    "node-fetch": "latest",
    "node-schedule": "latest",
    "request": "latest",
    "require-from-url": "latest",
    "screenshot-desktop": "1.15.3",
    "ws": "latest",
    "xhr2": "0.2.1"
